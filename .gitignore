# Entornos virtuales
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# pytest-cov (tarea 2.8) deja este fichero de datos al medir coverage.
.coverage
htmlcov/

# Caches de las herramientas de desarrollo. Hoy no salen en `git status`
# porque mypy, ruff y pytest escriben su propio .gitignore dentro de cada
# carpeta, pero eso es una cortesia de la herramienta, no una garantia: en
# cuanto alguien borre ese fichero interno -o use una version que no lo
# genere- se cuelan aqui 70 MB de cache de mypy en un commit. El
# .dockerignore ya las excluye desde la Fase 2 por el mismo motivo.
.mypy_cache/
.ruff_cache/

# Configuracion de editor. Es de cada uno, no del proyecto.
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/

# Sistema
.DS_Store
Thumbs.db
